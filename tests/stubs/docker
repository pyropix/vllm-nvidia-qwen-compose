#!/usr/bin/env bash
# Stub docker: log argv; `ps` prints the canned lines from $STUB_DOCKER_PS,
# `logs` prints the canned lines from $STUB_DOCKER_LOGS.
echo "docker $*" >>"${STUB_LOG}"
echo "docker-env MAX_MODEL_LEN=${MAX_MODEL_LEN-}" >>"${STUB_LOG}"
for arg in "$@"; do
  if [[ "${arg}" == ps ]]; then cat "${STUB_DOCKER_PS}"; fi
  if [[ "${arg}" == logs ]]; then cat "${STUB_DOCKER_LOGS}"; fi
done
exit 0
