#!/usr/bin/env bash
# Stub curl: log argv; fail (exit $STUB_CURL_EXIT, default 22) when $STUB_CURL_FAIL is set,
# or for the first $STUB_CURL_FAIL_TIMES calls (counted in $STUB_CURL_CALLS); else print $STUB_CURL_OUT.
echo "curl $*" >>"${STUB_LOG}"
[[ -n "${STUB_CURL_FAIL}" ]] && exit "${STUB_CURL_EXIT:-22}"
if [[ -n "${STUB_CURL_FAIL_TIMES}" ]]; then
  calls=$(( $(cat "${STUB_CURL_CALLS}" 2>/dev/null || echo 0) + 1 ))
  echo "${calls}" >"${STUB_CURL_CALLS}"
  (( calls > STUB_CURL_FAIL_TIMES )) || exit "${STUB_CURL_EXIT:-22}"
fi
cat "${STUB_CURL_OUT}"
