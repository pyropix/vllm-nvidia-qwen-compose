HF_TOKEN=<huggingface_token>

# Model to download and serve.
# See models.json for the list of supported models.
MODEL_ID=nvidia/Qwen3.8-27B-NVFP4

# Optional variant of the model to use.
# Leave empty if no variant is needed.
MODEL_VARIANT=instanttensor

# Draft model for speculative decoding (set by `./vllm-serve.sh select`
# from models.json). Leave empty if the model has none.
DRAFT_MODEL_ID=z-lab/Qwen3.8-27B-DFlash2
